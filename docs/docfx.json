{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/EDIParser.Core",
          "files": [
            "EDIParser.Core.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "**/*.yml"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appName": "EDIParser Documentation",
      "_appTitle": "EDIParser",
      "_enableSearch": true,
      "_disableContribution": false
    },
    "template": [
      "default",
      "modern"
    ]
  }
}