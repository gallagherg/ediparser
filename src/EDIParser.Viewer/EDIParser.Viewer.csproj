<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <RootNamespace>EDIParser.Viewer</RootNamespace>
    <AssemblyName>EDIParserViewer</AssemblyName>
    <ApplicationIcon>Resources\EDI.ico</ApplicationIcon>
    <Version>1.0.0.0</Version>
    <Product>EDIParser Viewer</Product>
    <Company>EDIParser</Company>
    <Copyright>Copyright © 2009-2026 Gary Gallagher</Copyright>
    <Authors>Gary Gallagher</Authors>
    <Description>A .NET 8 library for parsing, inspecting, modifying, and generating ANSI X12, HL7, and UN/EDIFACT messages.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\EDI.ico" LogicalName="EDIParser.Viewer.Resources.EDI.ico" />
    <EmbeddedResource Include="Resources\edi.bmp" LogicalName="EDIParser.Viewer.Resources.edi.bmp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EDIParser.Core\EDIParser.Core.csproj" />
  </ItemGroup>
</Project>
